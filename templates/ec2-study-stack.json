{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Study stack: Amazon Linux EC2 managed through Systems Manager with no inbound security-group rules.",
  "Parameters": {
    "VpcCidr": {
      "Type": "String",
      "Default": "10.30.0.0/16",
      "AllowedPattern": "^(10\\.(?:[0-9]{1,3}\\.){2}[0-9]{1,3}|172\\.(?:1[6-9]|2[0-9]|3[0-1])\\.[0-9]{1,3}\\.[0-9]{1,3}|192\\.168\\.[0-9]{1,3}\\.[0-9]{1,3})/(?:1[6-9]|2[0-8])$"
    },
    "PublicSubnetCidr": {
      "Type": "String",
      "Default": "10.30.0.0/24"
    },
    "InstanceType": {
      "Type": "String",
      "Default": "t3.micro",
      "AllowedValues": ["t3.micro", "t3.small"]
    },
    "LatestAmiId": {
      "Type": "AWS::SSM::Parameter::Value<AWS::EC2::Image::Id>",
      "Default": "/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64"
    }
  },
  "Resources": {
    "StudyVpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": {"Ref": "VpcCidr"},
        "EnableDnsHostnames": true,
        "EnableDnsSupport": true,
        "Tags": [{"Key": "Name", "Value": "ec2-study-vpc"}]
      }
    },
    "InternetGateway": {
      "Type": "AWS::EC2::InternetGateway",
      "Properties": {
        "Tags": [{"Key": "Name", "Value": "ec2-study-igw"}]
      }
    },
    "GatewayAttachment": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "InternetGatewayId": {"Ref": "InternetGateway"},
        "VpcId": {"Ref": "StudyVpc"}
      }
    },
    "PublicSubnet": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {"Ref": "StudyVpc"},
        "CidrBlock": {"Ref": "PublicSubnetCidr"},
        "MapPublicIpOnLaunch": true,
        "Tags": [{"Key": "Name", "Value": "ec2-study-public"}]
      }
    },
    "PublicRouteTable": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {"Ref": "StudyVpc"},
        "Tags": [{"Key": "Name", "Value": "ec2-study-public-rt"}]
      }
    },
    "DefaultInternetRoute": {
      "Type": "AWS::EC2::Route",
      "DependsOn": "GatewayAttachment",
      "Properties": {
        "RouteTableId": {"Ref": "PublicRouteTable"},
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {"Ref": "InternetGateway"}
      }
    },
    "PublicRouteAssociation": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "RouteTableId": {"Ref": "PublicRouteTable"},
        "SubnetId": {"Ref": "PublicSubnet"}
      }
    },
    "InstanceSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "No inbound access; administer with Systems Manager",
        "VpcId": {"Ref": "StudyVpc"},
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0",
            "Description": "HTTPS for Systems Manager and package repositories"
          },
          {
            "IpProtocol": "udp",
            "FromPort": 53,
            "ToPort": 53,
            "CidrIp": "0.0.0.0/0",
            "Description": "DNS resolution"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 53,
            "ToPort": 53,
            "CidrIp": "0.0.0.0/0",
            "Description": "DNS fallback"
          }
        ],
        "Tags": [{"Key": "Name", "Value": "ec2-study-sg"}]
      }
    },
    "Ec2Role": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": {"Fn::Sub": "ec2-study-role-${AWS::Region}"},
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {"Service": ["ec2.amazonaws.com"]},
              "Action": ["sts:AssumeRole"]
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
        ],
        "Tags": [{"Key": "Purpose", "Value": "cloud-engineering-study"}]
      }
    },
    "InstanceProfile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Properties": {
        "Roles": [{"Ref": "Ec2Role"}]
      }
    },
    "StudyInstance": {
      "Type": "AWS::EC2::Instance",
      "DependsOn": "DefaultInternetRoute",
      "Properties": {
        "ImageId": {"Ref": "LatestAmiId"},
        "InstanceType": {"Ref": "InstanceType"},
        "IamInstanceProfile": {"Ref": "InstanceProfile"},
        "SubnetId": {"Ref": "PublicSubnet"},
        "SecurityGroupIds": [{"Ref": "InstanceSecurityGroup"}],
        "Monitoring": true,
        "MetadataOptions": {
          "HttpEndpoint": "enabled",
          "HttpTokens": "required"
        },
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/xvda",
            "Ebs": {
              "Encrypted": true,
              "DeleteOnTermination": true,
              "VolumeSize": 8,
              "VolumeType": "gp3"
            }
          }
        ],
        "UserData": {
          "Fn::Base64": {
            "Fn::Sub": "#!/bin/bash\nset -euxo pipefail\ndnf install -y nginx\nprintf 'cloud engineering study instance\\n' > /usr/share/nginx/html/index.html\nsystemctl enable --now nginx\n"
          }
        },
        "Tags": [
          {"Key": "Name", "Value": "ec2-study-instance"},
          {"Key": "Environment", "Value": "study"},
          {"Key": "Owner", "Value": "repository-user"}
        ]
      }
    },
    "HighCpuAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "Study alarm when average EC2 CPU exceeds 80 percent for 10 minutes",
        "Namespace": "AWS/EC2",
        "MetricName": "CPUUtilization",
        "Dimensions": [{"Name": "InstanceId", "Value": {"Ref": "StudyInstance"}}],
        "Statistic": "Average",
        "Period": 300,
        "EvaluationPeriods": 2,
        "Threshold": 80,
        "ComparisonOperator": "GreaterThanThreshold",
        "TreatMissingData": "missing"
      }
    }
  },
  "Outputs": {
    "VpcId": {"Value": {"Ref": "StudyVpc"}},
    "SubnetId": {"Value": {"Ref": "PublicSubnet"}},
    "InstanceId": {"Value": {"Ref": "StudyInstance"}},
    "PublicIp": {
      "Value": {"Fn::GetAtt": ["StudyInstance", "PublicIp"]},
      "Description": "Address is informational; the security group intentionally permits no inbound connections."
    },
    "SessionManagerHint": {
      "Value": {"Fn::Sub": "aws ssm start-session --target ${StudyInstance}"}
    }
  }
}
